   "source": [
    "# Databricks notebook source\n",
    "# MAGIC %md\n",
    "# MAGIC # 02 — Run DQ Pipeline\n",
    "# MAGIC Loads config, runs all rules, and writes results to the audit log.\n",
    "\n",
    "# COMMAND ----------\n",
    "\n",
    "# MAGIC %md\n",
    "# MAGIC ## Setup\n",
    "# MAGIC Add the project root to sys.path so src/ imports work correctly.\n",
    "\n",
    "# COMMAND ----------\n",
    "\n",
    "import sys\n",
    "sys.path.insert(0, \"/Workspace/Repos/<your-username>/dq_framework\")\n",
    "\n",
    "# COMMAND ----------\n",
    "\n",
    "from src.reporter import run_dq_pipeline\n",
    "\n",
    "# COMMAND ----------\n",
    "\n",
    "# MAGIC %md\n",
    "# MAGIC ## Run the pipeline\n",
    "\n",
    "# COMMAND ----------\n",
    "\n",
    "run_id, results = run_dq_pipeline(\n",
    "    spark=spark,\n",
    "    config_path=\"config/rules.yaml\",\n",
    "    audit_log_path=\"dbfs:/dq_framework/audit_log\",\n",
    ")\n",
    "\n",
    "# COMMAND ----------\n",
    "\n",
    "# MAGIC %md\n",
    "# MAGIC ## Inspect the audit log\n",
    "\n",
    "# COMMAND ----------\n",
    "\n",
    "audit_df = spark.read.format(\"delta\").load(\"dbfs:/dq_framework/audit_log\")\n",
    "audit_df.filter(audit_df.run_id == run_id).orderBy(\"table_name\", \"rule_id\").display()\n",
    "\n",
    "# COMMAND ----------\n",
    "\n",
    "# MAGIC %md\n",
    "# MAGIC ## Failed rules only\n",
    "\n",
    "# COMMAND ----------\n",
    "\n",
    "(\n",
    "    audit_df\n",
    "    .filter((audit_df.run_id == run_id) & (audit_df.status == \"fail\"))\n",
    "    .orderBy(\"severity\", \"failure_rate\")\n",
    "    .display()\n",
    ")\n"
   ],
